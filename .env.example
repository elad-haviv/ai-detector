# ─── Kulmus server configuration ────────────────────────────────────────────────
# No database: nothing about users or keys is stored server-side. Identity lives in a signed
# cookie, subscriptions are looked up in Paddle by email. Every block below is optional; a missing
# block switches that feature off cleanly (sign-in buttons are disabled, pricing shows "בקרוב").

# Public URL of the app (no trailing slash). Used for the Google redirect URI, redirects after
# sign-in, the Secure cookie decision, and as HTTP-Referer for OpenRouter.
APP_URL=http://localhost:3000

# ─── Sessions ───────────────────────────────────────────────────────────────────
# HMAC-SHA256 key for the kulmus_session / kulmus_oauth cookies. At least 32 characters.
# Generate: openssl rand -base64 48
# Rotating it signs everyone out (that is the only "session store" there is).
SESSION_SECRET=

# ─── Sign in with Google (OAuth 2.0 client, type "Web application") ──────────────
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Paddle Billing (merchant of record) ────────────────────────────────────────
# Server API key (Paddle → Developer tools → Authentication). Never exposed to the browser.
PADDLE_API_KEY=
# sandbox → https://sandbox-api.paddle.com, production → https://api.paddle.com
PADDLE_ENV=sandbox
# Client-side token for Paddle.js (starts with test_ in sandbox, live_ in production).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Price ids (pri_…). Monthly is required for checkout; yearly adds a monthly/yearly toggle.
NEXT_PUBLIC_PADDLE_PRICE_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_YEARLY=
# Display labels on /pricing (Paddle shows the real price, tax included, in checkout).
NEXT_PUBLIC_PRO_PRICE_LABEL=₪29 לחודש
NEXT_PUBLIC_PRO_PRICE_LABEL_YEARLY=
# Checkout language (Paddle falls back to the browser language if unsupported).
NEXT_PUBLIC_PADDLE_LOCALE=he
# Days a past_due subscription keeps Pro while Paddle retries the payment (default 14).
PAST_DUE_GRACE_DAYS=14

# ─── Managed (Pro) mode ─────────────────────────────────────────────────────────
# Server-side provider keys. Used ONLY for requests from an active subscriber, as decided by
# getEntitlement(req) in src/lib/server/entitlement.ts. Everyone else must bring their own key;
# without one the API answers 401 missing_key (the browser runs local rules only).
OPENROUTER_API_KEY=
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
# Which provider and model the server uses for subscribers.
# MANAGED_PROVIDER: openrouter | openai | anthropic | google | xai (default: openrouter)
# MANAGED_MODEL: model id for that provider (default per provider, e.g. anthropic/claude-sonnet-5.5)
# The OpenRouter key above also powers the decision model (OpenRouter Decisions) for subscribers.
MANAGED_PROVIDER=openrouter
MANAGED_MODEL=
# Fair use: model calls (analyze chunks, document assessments, rewrites) per subscriber per hour.
# Best-effort, in memory, per server instance.
PRO_RATE_LIMIT_PER_HOUR=100

# "Sign in with ChatGPT" is a limited OpenAI preview; keep 0 until it is open to third parties.
NEXT_PUBLIC_CHATGPT_SIGNIN=0
