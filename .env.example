# Optional server-side keys. If set, they are used when the browser sends no key
# (handy for a private deployment, and the basis for the future paid tier).
OPENROUTER_API_KEY=
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Public URL, sent to OpenRouter as HTTP-Referer
APP_URL=http://localhost:3000
