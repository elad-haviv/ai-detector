# Server-side provider keys. Used ONLY for requests from an entitled (paying) subscriber,
# as decided by getEntitlement(req) in src/lib/server/entitlement.ts. Everyone else must
# bring their own key; without one the API answers 401 missing_key (local rules only).
# Until subscriptions ship (M3) nobody is entitled, so these are never used.
OPENROUTER_API_KEY=
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Managed (subscription) mode: which provider and model the server uses for subscribers.
# MANAGED_PROVIDER: openrouter | openai | anthropic | google | xai (default: openrouter)
# MANAGED_MODEL: model id for that provider (default per provider, e.g. anthropic/claude-sonnet-5.5)
# The OpenRouter key above also powers the decision model (OpenRouter Decisions) for subscribers.
MANAGED_PROVIDER=openrouter
MANAGED_MODEL=

# "Sign in with ChatGPT" is a limited OpenAI preview; keep 0 until it is open to third parties.
NEXT_PUBLIC_CHATGPT_SIGNIN=0

# Public URL, sent to OpenRouter as HTTP-Referer
APP_URL=http://localhost:3000
